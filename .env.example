# ==================================================
# FLASK CORE
# ==================================================
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=true

# ==================================================
# DATABASE
# ==================================================
# Dev default (SQLite). For production point this at PostgreSQL, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/jobmarket_ai
DATABASE_URL=sqlite:///jobmarket_ai.db

# ==================================================
# EMAIL
# ==================================================
# Leave MAIL_SERVER empty in development: emails are written to
# logs/dev_emails.log and printed to the console instead of being sent,
# so the full auth flow works with zero email setup.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@jobmarket-ai.local

# ==================================================
# SECURITY / SESSIONS
# ==================================================
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_DAYS=14
EMAIL_TOKEN_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_MINUTES=30

# ==================================================
# AI PROVIDERS (wired up in a later phase)
# ==================================================
AI_PROVIDER=gemini
AI_PROVIDER_ORDER=gemini,groq,openrouter,claude

GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
